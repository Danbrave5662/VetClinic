@model IEnumerable<VetClinic.Models.Vet>

@{
    ViewData["Title"] = "Ветлікарі";
}

<h2>Ветлікарі</h2>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">Додати ветлікаря</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На головну</a>
</div>

<!-- Окремі поля пошуку -->
<form asp-action="Index" method="get" class="mb-3 d-flex gap-2 flex-wrap" autocomplete="off">
    <!-- 1. Пошук за ПІБ -->
    <div class="w-auto">
        <input type="text" 
               id="nameInput"
               name="searchName" 
               value="@ViewBag.CurrentName" 
               class="form-control" 
               placeholder="Пошук за ПІБ..." 
               list="namesList" 
               autocomplete="off" />

        <datalist id="namesList">
            @foreach (var name in Model.Select(v => v.FullName).Distinct())
            {
                <option value="@name"></option>
            }
        </datalist>
    </div>

    <!-- 2. Фільтр за спеціалізацією -->
    <div class="w-auto">
        <select name="searchSpec" id="specSelect" class="form-select">
            <option value="">-- Усі спеціалізації --</option>
            <option value="Терапевт" selected="@(ViewBag.CurrentSpec == "Терапевт")">Терапевт</option>
            <option value="Хірург" selected="@(ViewBag.CurrentSpec == "Хірург")">Хірург</option>
            <option value="Ортопед" selected="@(ViewBag.CurrentSpec == "Ортопед")">Ортопед</option>
            <option value="Дерматолог" selected="@(ViewBag.CurrentSpec == "Дерматолог")">Дерматолог</option>
            <option value="Офтальмолог" selected="@(ViewBag.CurrentSpec == "Офтальмолог")">Офтальмолог</option>
            <option value="Стоматолог" selected="@(ViewBag.CurrentSpec == "Стоматолог")">Стоматолог</option>
        </select>
    </div>

    <button type="submit" class="btn btn-outline-primary">Шукати</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
</form>

<table class="table align-middle" id="vetsTable">
    <thead>
        <tr>
            <th>ПІБ</th>
            <th>Телефон</th>
            <th>Спеціалізація</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="vet-name">@item.FullName</td>
            <td>@item.Phone</td>
            <td class="vet-spec">@item.Specialization</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        // Жива фільтрація таблиці одночасно за обома полями
        function filterVets() {
            const nameFilter = document.getElementById('nameInput').value.toLowerCase().trim();
            const specFilter = document.getElementById('specSelect').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#vetsTable tbody tr');

            rows.forEach(row => {
                const nameCell = row.querySelector('.vet-name');
                const specCell = row.querySelector('.vet-spec');

                const nameText = nameCell ? nameCell.textContent.toLowerCase() : '';
                const specText = specCell ? specCell.textContent.toLowerCase() : '';

                const matchesName = nameText.includes(nameFilter);
                const matchesSpec = specFilter === '' || specText.includes(specFilter);

                if (matchesName && matchesSpec) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        document.getElementById('nameInput').addEventListener('input', filterVets);
        document.getElementById('specSelect').addEventListener('change', filterVets);
    </script>
}