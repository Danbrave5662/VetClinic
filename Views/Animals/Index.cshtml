@model IEnumerable<VetClinic.Models.Animal>

@{
    ViewData["Title"] = "Тварини";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Тварини</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На головну</a>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Додати тварину</a>
</div>

<form asp-action="Index" method="get" class="mb-3 d-flex gap-2 flex-wrap" autocomplete="off">
    <div class="w-auto">
        <input type="text" 
               id="nameInput"
               name="searchName" 
               value="@ViewBag.CurrentName" 
               class="form-control" 
               placeholder="Пошук за ім'ям..." 
               list="animalNamesList" 
               autocomplete="off" />

        <datalist id="animalNamesList">
            @foreach (var name in Model.Select(a => a.Name).Distinct())
            {
                <option value="@name"></option>
            }
        </datalist>
    </div>

    <div class="w-auto">
        <input type="text" 
               id="speciesInput"
               name="searchSpecies" 
               value="@ViewBag.CurrentSpecies" 
               class="form-control" 
               placeholder="Вид (кіт, собака...)" 
               list="speciesList" 
               autocomplete="off" />

        <datalist id="speciesList">
            @foreach (var species in Model.Select(a => a.Species).Distinct())
            {
                <option value="@species"></option>
            }
        </datalist>
    </div>

    <div class="w-auto">
        <input type="text" 
               id="ownerInput"
               name="searchOwner" 
               value="@ViewBag.CurrentOwner" 
               class="form-control" 
               placeholder="Пошук за власником..." 
               list="ownersList" 
               autocomplete="off" />

        <datalist id="ownersList">
            @foreach (var owner in Model.Where(a => a.Client != null).Select(a => a.Client.FullName).Distinct())
            {
                <option value="@owner"></option>
            }
        </datalist>
    </div>

    <button type="submit" class="btn btn-outline-primary">Шукати</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
</form>

<table class="table align-middle" id="animalsTable">
    <thead>
        <tr>
            <th>Ім'я</th>
            <th>Вид</th>
            <th>Порода</th>
            <th>Вік</th>
            <th>Власник</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="animal-name">@item.Name</td>
            <td class="animal-species">@item.Species</td>
            <td>@item.Breed</td>
            <td>@item.Age</td>
            <td class="animal-owner">@(item.Client != null ? item.Client.FullName : "—")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        function filterAnimals() {
            const nameFilter = document.getElementById('nameInput').value.toLowerCase().trim();
            const speciesFilter = document.getElementById('speciesInput').value.toLowerCase().trim();
            const ownerFilter = document.getElementById('ownerInput').value.toLowerCase().trim();

            const rows = document.querySelectorAll('#animalsTable tbody tr');

            rows.forEach(row => {
                const nameText = row.querySelector('.animal-name')?.textContent.toLowerCase() || '';
                const speciesText = row.querySelector('.animal-species')?.textContent.toLowerCase() || '';
                const ownerText = row.querySelector('.animal-owner')?.textContent.toLowerCase() || '';

                const matchesName = nameText.includes(nameFilter);
                const matchesSpecies = speciesText.includes(speciesFilter);
                const matchesOwner = ownerText.includes(ownerFilter);

                if (matchesName && matchesSpecies && matchesOwner) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        document.getElementById('nameInput').addEventListener('input', filterAnimals);
        document.getElementById('speciesInput').addEventListener('input', filterAnimals);
        document.getElementById('ownerInput').addEventListener('input', filterAnimals);
    </script>
}