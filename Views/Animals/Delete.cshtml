@model VetClinic.Models.Animal

@{
    ViewData["Title"] = "Видалити тварину";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-danger">Видалити тварину?</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На головну</a>
</div>

<div class="card p-3 mb-3">
    <h5>Ви дійсно хочете видалити цю тварину з бази даних?</h5>
    <hr />
    <dl class="row mb-0">
        <dt class="col-sm-3">Ім'я</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Вид</dt>
        <dd class="col-sm-9">@Model.Species</dd>

        <dt class="col-sm-3">Порода</dt>
        <dd class="col-sm-9">@Model.Breed</dd>

        <dt class="col-sm-3">Власник</dt>
        <dd class="col-sm-9">@(Model.Client != null ? Model.Client.FullName : "—")</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>