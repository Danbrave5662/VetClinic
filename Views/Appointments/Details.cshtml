@model VetClinic.Models.Appointment

@{
    ViewData["Title"] = "Деталі прийому";
    decimal totalSum = Model.Services != null ? Model.Services.Sum(s => s.Price) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Прийом: @(Model.Animal != null ? Model.Animal.Name : "Тварина")</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На головну</a>
</div>

<div class="card p-3 mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Дата й час</dt>
        <dd class="col-sm-9">@Model.DateTime.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-3">Ветлікар</dt>
        <dd class="col-sm-9">@(Model.Vet != null ? Model.Vet.FullName + " (" + Model.Vet.Specialization + ")" : "Не призначено")</dd>

        <dt class="col-sm-3">Скарги</dt>
        <dd class="col-sm-9">@Model.Complaints</dd>

        <dt class="col-sm-3">Статус</dt>
        <dd class="col-sm-9">
            @switch (Model.Status)
            {
                case VetClinic.Models.AppointmentStatus.Planned:
                    <span class="badge bg-warning text-dark">Запланований</span>
                    if (Model.DateTime.Date < DateTime.Today)
                    {
                        <span class="badge bg-secondary">Прострочено</span>
                    }
                    break;
                case VetClinic.Models.AppointmentStatus.InProgress:
                    <span class="badge bg-info text-dark">В процесі</span>
                    break;
                case VetClinic.Models.AppointmentStatus.WaitingPayment:
                    <span class="badge bg-primary">Очікує оплати</span>
                    break;
                case VetClinic.Models.AppointmentStatus.Completed:
                    <span class="badge bg-success">Завершений</span>
                    break;
                case VetClinic.Models.AppointmentStatus.Cancelled:
                    <span class="badge bg-danger">Скасований</span>
                    break;
                default:
                    <span class="badge bg-secondary">@Model.Status</span>
                    break;
            }
        </dd>
    </dl>
</div>

<h4>Послуги й рахунок</h4>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Послуга</th>
            <th class="text-end">Ціна, грн</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Services != null && Model.Services.Any())
        {
            @foreach (var service in Model.Services)
            {
                <tr>
                    <td>@service.Name</td>
                    <td class="text-end">@service.Price.ToString("F2")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-muted">Наданих послуг поки немає</td>
            </tr>
        }
        <tr class="fw-bold table-light">
            <td>Разом до сплати</td>
            <td class="text-end">@totalSum.ToString("F2") грн</td>
        </tr>
    </tbody>
</table>

@if (Model.Status == VetClinic.Models.AppointmentStatus.InProgress || Model.Status == VetClinic.Models.AppointmentStatus.Planned)
{
    <form asp-action="AddService" method="post" class="mb-4">
        <input type="hidden" name="appointmentId" value="@Model.Id" />

        <div class="mb-2">
            @foreach (var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ServicesList)
            {
                var added = Model.Services != null && Model.Services.Any(x => x.Id.ToString() == s.Value);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="serviceIds" value="@s.Value" id="svc@(s.Value)" disabled="@added" />
                    <label class="form-check-label" for="svc@(s.Value)">
                        @s.Text @(added ? "(вже додано)" : "")
                    </label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Додати вибрані послуги</button>
    </form>
}

<div class="d-flex gap-2">
    @if (Model.Status == VetClinic.Models.AppointmentStatus.Planned)
    {
        @if (Model.DateTime.Date >= DateTime.Today)
        {
            <form asp-action="StartExam" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">Почати огляд</button>
            </form>
        }
        else
        {
            <span class="text-danger align-self-center">Прийом прострочено. Змініть дату, щоб почати огляд.</span>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">Редагувати</a>
    }
    else if (Model.Status == VetClinic.Models.AppointmentStatus.InProgress)
    {
        <form asp-action="ProceedToPayment" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-warning">Перейти до оплати</button>
        </form>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">Редагувати</a>
    }
    else if (Model.Status == VetClinic.Models.AppointmentStatus.WaitingPayment)
    {
        <form asp-action="CompleteAppointment" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Оплатити рахунок</button>
        </form>
    }

    <a asp-action="Index" class="btn btn-secondary">До списку прийомів</a>
</div>