@model VetClinic.Models.Client

@{
    ViewData["Title"] = "Новий клієнт";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Новий клієнт</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На головну</a>
</div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">ПІБ</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label">Телефон</label>
        <input asp-for="Phone" class="form-control" placeholder="+380..." />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label">Email</label>
        <input asp-for="Address" class="form-control" placeholder="name@gmail.com" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>