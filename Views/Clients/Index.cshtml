@model IEnumerable<VetClinic.Models.Client>

@{
    ViewData["Title"] = "Клієнти";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Клієнти</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На головну</a>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Додати клієнта</a>
</div>

<form asp-action="Index" method="get" class="mb-3 d-flex gap-2 flex-wrap" autocomplete="off">
    <div class="w-auto">
        <input type="text"
               id="nameInput"
               name="searchName"
               value="@ViewBag.CurrentName"
               class="form-control"
               placeholder="Пошук за ПІБ..."
               list="clientNamesList"
               autocomplete="off" />

        <datalist id="clientNamesList">
            @foreach (var name in Model.Select(c => c.FullName).Distinct())
            {
                <option value="@name"></option>
            }
        </datalist>
    </div>

    <div class="w-auto">
        <input type="text"
               id="phoneInput"
               name="searchPhone"
               value="@ViewBag.CurrentPhone"
               class="form-control"
               placeholder="Пошук за телефоном..."
               list="phonesList"
               autocomplete="off" />

        <datalist id="phonesList">
            @foreach (var phone in Model.Select(c => c.Phone).Distinct())
            {
                <option value="@phone"></option>
            }
        </datalist>
    </div>

    <button type="submit" class="btn btn-outline-primary">Шукати</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
</form>

<table class="table align-middle" id="clientsTable">
    <thead>
        <tr>
            <th>ПІБ</th>
            <th>Телефон</th>
            <th>Email</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="client-name">@item.FullName</td>
            <td class="client-phone">@item.Phone</td>
            <td>@item.Address</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        function filterClients() {
            const nameFilter = document.getElementById('nameInput').value.toLowerCase().trim();
            const phoneFilter = document.getElementById('phoneInput').value.toLowerCase().trim();

            const rows = document.querySelectorAll('#clientsTable tbody tr');

            rows.forEach(row => {
                const nameText = row.querySelector('.client-name')?.textContent.toLowerCase() || '';
                const phoneText = row.querySelector('.client-phone')?.textContent.toLowerCase() || '';

                const matchesName = nameText.includes(nameFilter);
                const matchesPhone = phoneText.includes(phoneFilter);

                if (matchesName && matchesPhone) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        document.getElementById('nameInput').addEventListener('input', filterClients);
        document.getElementById('phoneInput').addEventListener('input', filterClients);
    </script>
}