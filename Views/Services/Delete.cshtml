@model VetClinic.Models.Service

@{
    ViewData["Title"] = "Видалити послугу";
}

<h2 class="text-danger">Видалити послугу?</h2>

<div class="card p-3 mb-3">
    <h5>Ви дійсно хочете видалити цю послугу?</h5>
    <hr />
    <dl class="row mb-0">
        <dt class="col-sm-3">Назва</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Ціна</dt>
        <dd class="col-sm-9">@Model.Price.ToString("F2") грн</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>